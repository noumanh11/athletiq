# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# generated native folders (Continuous Native Generation: `npx expo prebuild` / `npx expo run:android`)
/ios
/android

# Native signing keys and build leftovers
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.apk
*.aab
*.ipa

# Metro
.metro-health-check*

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files
.env
.env*.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE (shared .vscode/settings.json and .vscode/extensions.json stay tracked)
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code: shared settings.json is tracked, personal overrides are not
.claude/settings.local.json
